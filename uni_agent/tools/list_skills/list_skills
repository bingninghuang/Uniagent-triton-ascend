#!/usr/bin/env python3
"""List all available skills with metadata parsed from SKILL.md frontmatter.

Scans SKILLS_DIR/*/SKILL.md, parses YAML frontmatter (name/description),
and prints a summary for each skill. Zero external dependencies.
"""

from __future__ import annotations

import os
import re
from pathlib import Path


def _parse_frontmatter(content: str) -> dict:
    """Parse YAML frontmatter between --- markers. Extracts name and
    description. Handles `>-` / `>` multi-line folded scalars."""
    meta: dict = {"name": "", "description": ""}
    m = re.match(r"^---\s*\n(.*?)\n---\s*\n", content, re.DOTALL)
    if not m:
        return meta
    block = m.group(1)
    for key in ("name", "description"):
        # match `key: >` or `key: >-` or `key: |` (multi-line folded scalar)
        multi = re.search(
            rf"^{re.escape(key)}:\s*[>|][+-]?\s*\n((?:[ \t]+.*\n?)+)",
            block,
            re.MULTILINE,
        )
        if multi:
            lines = [ln.strip() for ln in multi.group(1).splitlines() if ln.strip()]
            meta[key] = " ".join(lines)
            continue
        # match `key: value` (single line)
        single = re.search(rf"^{re.escape(key)}:\s*(\S.*?)$", block, re.MULTILINE)
        if single:
            meta[key] = single.group(1).strip()
    return meta


def list_skills(skills_dir: str) -> str:
    root = Path(skills_dir)
    if not root.is_dir():
        return f"Skills directory not found: {skills_dir}"

    # find all SKILL.md under skill subdirectories
    skill_files = sorted(root.glob("*/SKILL.md"))
    if not skill_files:
        return f"No skills found under: {skills_dir}"

    lines: list[str] = []
    for sf in skill_files:
        try:
            content = sf.read_text(encoding="utf-8", errors="replace")
        except Exception:
            continue
        meta = _parse_frontmatter(content)
        skill_name = meta.get("name") or sf.parent.name
        desc = meta.get("description", "").strip()
        # take first sentence of description
        if desc:
            desc = desc.split("。")[0].split(". ")[0]
        rel = sf.relative_to(root).parent
        # count reference files
        refs_dir = sf.parent / "references"
        ref_count = 0
        if refs_dir.is_dir():
            ref_count = sum(1 for _ in refs_dir.rglob("*") if _.is_file())
        lines.append(f"## {skill_name}")
        lines.append(f"description: {desc}")
        lines.append(f"path: {rel}/SKILL.md")
        lines.append(f"references: {ref_count} files")
        lines.append("")
    return "\n".join(lines).rstrip() + "\n"


def main() -> None:
    skills_dir = os.environ.get(
        "SKILLS_DIR", "/opt/workspace/agent_workdir/.skills"
    )
    print(list_skills(skills_dir))


if __name__ == "__main__":
    main()
